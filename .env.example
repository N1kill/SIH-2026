# Optional near-real-time Earth Engine imagery; authenticate separately.
EE_PROJECT=
# Optional service-account key file; keep outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=
# Generic dam evidence agent. Keep the key local and never commit .env.
OPENAI_API_KEY=
DAM_RESEARCH_MODEL=openai:gpt-5-mini
# Search and coordinator providers are independent.
# Values: auto, openai, google, ollama, or local searxng.
DAM_SEARCH_PROVIDER=auto
SEARXNG_URL=http://localhost:8888
SEARXNG_SECRET=
DAM_RESEARCH_OLLAMA_NUM_CTX=8192
DAM_RESEARCH_OLLAMA_NUM_PREDICT=768
DAM_MODEL_RATE_LIMIT_DELAY_S=0.5
# Local research checks four topics, at most three documents each, within this budget.
DAM_RESEARCH_MAX_SECONDS=600
# Optional Google alternative: use DAM_RESEARCH_MODEL=google_genai:gemini-3.6-flash.
GEMINI_API_KEY=
# Free-tier providers commonly allow about five requests per minute. Set 0 for paid
# plans with higher limits. This deliberately makes the evidence run slower but safer.
DAM_RESEARCH_RATE_LIMIT_DELAY_S=12.5
# Ollama local coordinator/search settings. Qwen3 supports tool calling.
OLLAMA_HOST=http://localhost:11434
OLLAMA_API_KEY=
# Optional external solvers must be installed and added to PATH.
# dflowfm-cli / foamRun are detected; the default CPU screening solver needs neither.
